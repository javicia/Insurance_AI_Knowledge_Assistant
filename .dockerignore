# Keeps the Docker build context small and prevents stale local artifacts from leaking into the
# image - everything here is either regenerated fresh inside the multi-stage build or must never
# ship in an image (secrets, IDE state, VCS history). See docs/frontend/FRONTEND_ARCHITECTURE.md.

.git
.gitignore

# Backend build output - regenerated by the backend-build stage.
target/

# Frontend build output/dependencies - regenerated by the frontend-build stage.
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Never ship secrets or local environment files - the running container receives configuration
# via docker-compose environment variables, never by reading a file baked into the image.
.env
.env.*

# IDE / OS noise.
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs and local scratch files.
*.log
*.log.txt

# Documentation and reports are not needed inside the image.
docs/
FINAL_PROJECT_REPORT.md
FINAL_ARCHITECTURE_AUDIT.md
FINAL_FRONTEND_AUDIT.md

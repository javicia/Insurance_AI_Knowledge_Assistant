# Copy this file to .env and fill in real values locally. Never commit .env.
# These map to the spring-ai-starter-model-openai / spring-ai-starter-model-anthropic
# auto-configuration properties (spring.ai.openai.api-key / spring.ai.anthropic.api-key).
# Neither provider is called yet in FASE 1 — see insurance-ai.ai.provider in application.yaml
# for which provider is active once the LlmProvider adapters land in FASE 7.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Read by docker-compose.yml (Postgres container credentials). Defaults already work out of
# the box for local development (see docker-compose.yml) - only override if you need to.
POSTGRES_DB=insurance_ai
POSTGRES_USER=insurance_ai
POSTGRES_PASSWORD=insurance_ai

# Read by docker-compose.yml's insurance-ai service (FASE 15 - packaged Angular+Spring Boot
# image). Defaults to the deterministic fake provider so the full product (including the
# Angular UI) runs end to end with no real OpenAI/Anthropic credentials required. Set to
# openai/anthropic (with the matching key above) to use a real provider instead.
INSURANCE_AI_PROVIDER=fake

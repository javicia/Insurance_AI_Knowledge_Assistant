<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.rag.springai</groupId>
    <artifactId>insurance-knowledge-assistant</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Insurance Knowledge Assistant</name>
    <description>RAG-based Insurance Knowledge Assistant PoC: DDD + Hexagonal Architecture, Spring AI, AI Governance and GenAI security controls</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <archunit.version>1.5.0</archunit.version>
        <opentelemetry-instrumentation.version>2.30.0</opentelemetry-instrumentation.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <!-- FASE 11 (Observability): health checks (DB/Kafka, auto-configured from the
                 already-present DataSource/KafkaAdmin beans) and a metrics registry
                 (MeterRegistry) for the custom RAG-stage latency timers - see
                 docs/observability/OBSERVABILITY.md. Deliberately no Prometheus/Grafana/APM
                 stack: this is a PoC, not production monitoring infrastructure. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- FASE 12 (API documentation): generates /v3/api-docs (OpenAPI 3 JSON) and a
                 browsable /swagger-ui.html directly from the existing @RestController classes
                 and their record-based DTOs - no separate documentation site/tooling. Version
                 3.x is the first springdoc line built for Spring Boot 4/Spring Framework 7 (the
                 2.x line targets Boot 3); see docs/adr/ADR-011-API-DOCUMENTATION.md. -->
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <!-- FASE 25 (Distributed Tracing): the officially OpenTelemetry-project-maintained
                 Spring Boot starter, not Spring Boot's own `management.tracing.*`/
                 `micrometer-tracing-bridge-otel` combination - found and switched to after that
                 combination genuinely failed to produce a real `Tracer` bean against Spring Boot
                 4.1.0 (confirmed via `/actuator/conditions`: `NoopTracerAutoConfiguration`
                 activated, `MicrometerTracingAutoConfiguration`'s propagator-dependent handlers
                 stayed unmatched - Boot 4.1.0's own tracing auto-configuration module,
                 `spring-boot-micrometer-tracing`, ships no class that actually constructs an
                 OpenTelemetry SDK `Tracer`/`Propagator` bean, unlike Boot 3.x's now-removed
                 `spring-boot-actuator-autoconfigure` tracing package). This starter auto-
                 configures the full SDK (tracer provider, OTLP exporter, propagators) and the
                 Micrometer bridge itself, independent of Spring Boot's own release cadence for
                 tracing support - see docs/observability/DISTRIBUTED_TRACING.md section 2 for the
                 full incident writeup. Reads standard `OTEL_*` env vars (`OTEL_SERVICE_NAME`,
                 `OTEL_EXPORTER_OTLP_ENDPOINT`) - see docker-compose.yml. -->
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-spring-boot-starter</artifactId>
            <!-- Version managed by the opentelemetry-instrumentation-bom import below - keeping
                 this artifact's own version implicit (rather than re-pinning it here too) is what
                 actually guarantees it stays aligned with every other io.opentelemetry* artifact
                 the BOM manages. -->
        </dependency>
        <dependency>
            <!-- FASE 25: populates SLF4J MDC with the real OpenTelemetry trace_id/span_id for
                 every log line emitted while a span is active - without this, spans genuinely
                 export to Jaeger correctly (verified independently) but every log line still
                 shows `traceId=none spanId=none`, since the starter's own SDK wiring alone does
                 not touch MDC. Explicitly versioned (not BOM-managed): this module's alpha
                 release train is versioned independently of the stable
                 `opentelemetry-instrumentation-bom` this project otherwise uses. -->
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-mdc-1.0</artifactId>
            <version>2.30.0-alpha</version>
        </dependency>
        <!-- FASE 25: real JDBC spans (PgVectorStoreAdapter/JdbcDocumentRepository/etc. queries)
             come from `opentelemetry-spring-boot-starter`'s own bundled JDBC auto-instrumentation
             (`io.opentelemetry.instrumentation:opentelemetry-jdbc`, pulled in transitively) - a
             separate `net.ttddyy:datasource-micrometer-spring-boot` dependency was tried first
             and removed: both libraries wrap the same DataSource/Statement, and running both
             together produced a real
             `NoClassDefFoundError: io/opentelemetry/api/impl/InstrumentationUtil` crash on the
             very first JDBC query - see this file's opentelemetry-instrumentation-bom comment for
             the full incident. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>
        <dependency>
            <!-- FASE 17 (IAM): validates JWTs issued by a real OIDC provider (Keycloak) - never
                 hand-rolled JWT parsing/signature verification. See
                 docs/security/IAM_ARCHITECTURE.md and adapters.inbound.security.SecurityConfiguration. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <!-- Like Kafka, Flyway autoconfiguration lives in this dedicated Spring Boot 4
                 module (which transitively brings flyway-core) rather than in
                 spring-boot-autoconfigure. flyway-database-postgresql is still required
                 separately: Flyway 10+ split database-specific support out of flyway-core. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <!-- Spring Boot 4 moved Kafka autoconfiguration (KafkaAutoConfiguration,
                 KafkaConnectionDetails, and the Testcontainers @ServiceConnection factory for
                 KafkaContainer) out of spring-boot-autoconfigure into this dedicated module.
                 Without it, spring.kafka.* properties are never bound and @ServiceConnection
                 on a KafkaContainer bean fails with ConnectionDetailsNotFoundException. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- FASE 17 (IAM): a real Keycloak container, not a mock IdP - used by
                 KeycloakJwtValidationTest to prove SecurityConfiguration's JwtDecoder genuinely
                 accepts a validly-signed token and rejects a tampered signature / wrong issuer,
                 against an actual OIDC provider rather than only hand-built Jwt objects. -->
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>4.3.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Polls for the async Kafka-driven pipeline (upload -> processed) to complete in
                 integration tests, instead of hand-rolled sleep loops. Version managed by
                 spring-boot-starter-parent's dependency management. -->
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- MockMvc's jwt()/authorities() request post-processors - the standard way to test
                 Spring Security authorization rules without a running identity provider. -->
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- FASE 25 (Distributed Tracing): pins every io.opentelemetry*/io.opentelemetry.
                     instrumentation* artifact transitively pulled in by
                     `opentelemetry-spring-boot-starter` to one mutually-compatible version set -
                     found genuinely necessary, not precautionary: without this BOM, one of the
                     starter's own transitive `opentelemetry-api` resolutions collided with
                     another, producing a real
                     `NoClassDefFoundError: io/opentelemetry/api/impl/InstrumentationUtil` at
                     runtime (inside the starter's own JDBC auto-instrumentation) the very first
                     time a JDBC query ran - a real bug, not a hypothetical one, root-caused via
                     the actual stack trace before adding this fix. -->
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>

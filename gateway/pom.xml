<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>com.rag.springai</groupId>
    <artifactId>insurance-knowledge-assistant-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Insurance Knowledge Assistant Gateway</name>
    <description>API Gateway (FASE 16/19): routing, CORS, correlation ID, and rate limiting in
        front of the independently-deployed backend and frontend - a genuinely separate Maven
        module and deployable artifact, sharing no code with backend/ or frontend/ (only an HTTP
        contract). See docs/adr/ADR-014-FRONTEND-BACKEND-SEPARATION.md and
        docs/architecture/API_GATEWAY.md.</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- Spring Cloud release train compatible with the spring-boot-starter-parent version
             above, following the same "Boot N.M -> Cloud <year>.0.x" cadence this project's
             backend already establishes for its own dependency choices (Spring Boot 4.1.0). -->
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <opentelemetry-instrumentation.version>2.30.0</opentelemetry-instrumentation.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- FASE 19: the gateway independently validates JWTs too (defense in depth - a
                 request the gateway itself already knows is unauthenticated/invalid never even
                 reaches the backend), reusing the same reactive resource-server auto-configuration
                 the WebFlux stack already on the classpath (spring-cloud-starter-gateway-server-
                 webflux) selects automatically. See GatewaySecurityConfiguration. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <!-- FASE 21: real per-key token-bucket rate limiting (RateLimitingFilter), not a
                 naive shared counter. In-memory for this single-gateway-instance PoC - see that
                 class's Javadoc for the documented migration path to a distributed backend
                 (bucket4j-redis) if the gateway is ever scaled horizontally. -->
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <dependency>
            <!-- FASE 25 (Distributed Tracing): the officially OpenTelemetry-project-maintained
                 starter, not Spring Boot's own tracing auto-configuration - see backend/pom.xml's
                 identical comment for the full incident writeup (Spring Boot 4.1.0's native
                 tracing module produces no real Tracer bean).
                 FASE 25 follow-up incident (found via real Jaeger evidence, not assumed): an
                 earlier revision of this comment claimed Spring Cloud Gateway's own routing was
                 "Observation-instrumented out of the box... propagated to the backend via W3C
                 traceparent" once this starter was on the classpath. That was wrong - disproven
                 by querying Jaeger's API for a real end-to-end request: the gateway produced a
                 real *inbound* server span (opentelemetry-spring-webflux-5.3, bundled
                 transitively by this starter), but the backend's span landed in a completely
                 different trace ID, proving no traceparent header was ever sent on the gateway's
                 outbound proxy call. Root cause: Spring Cloud Gateway Server WebFlux's routing
                 filter (`NettyRoutingFilter`) proxies every request through reactor-netty's raw
                 `HttpClient` directly, never through a Spring-managed `WebClient`/`RestClient`
                 bean - so this starter's webclient-family instrumentation
                 (opentelemetry-spring-web-3.1) never applies to it. A dedicated reactor-netty
                 instrumentation library (the obvious next thing to reach for) does not exist as
                 an importable dependency for this non-agent "library instrumentation" style
                 integration - OpenTelemetry only ships raw-Netty channel instrumentation
                 (`opentelemetry-netty-4.1` et al.) as *javaagent-only* bytecode-transformation
                 modules, unusable without switching the entire gateway to `-javaagent` attachment
                 (out of scope for this PoC's non-agent architecture). Fixed instead with a small,
                 targeted `GlobalFilter` (GatewayTracePropagationFilter) that injects the W3C
                 `traceparent`/`tracestate` headers onto the outbound request itself, before
                 `NettyRoutingFilter` proxies it. Note this starter registers a real `OpenTelemetry`
                 *bean* but does not necessarily install it as the JVM-global instance - that
                 filter must therefore inject the bean, not call `GlobalOpenTelemetry` (which
                 silently yields a no-op, header-injecting-nothing propagator). See that class's
                 Javadoc for all three real bugs found here and
                 docs/observability/DISTRIBUTED_TRACING.md section 6 for the end-to-end
                 verification evidence (gateway and backend spans sharing one trace ID). -->
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-spring-boot-starter</artifactId>
            <!-- Version managed by the opentelemetry-instrumentation-bom import below - see
                 backend/pom.xml's identical comment for why this must not be re-pinned here. -->
        </dependency>
        <dependency>
            <!-- FASE 25: same MDC population fix as the backend - see that module's identical
                 comment and logback-spring.xml for the real bug this fixes (this appender must be
                 explicitly wired, not just present on the classpath). -->
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-mdc-1.0</artifactId>
            <version>2.30.0-alpha</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- FASE 25: see backend/pom.xml's identical comment - pins every
                     io.opentelemetry*/io.opentelemetry.instrumentation* artifact to one
                     mutually-compatible version set. -->
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

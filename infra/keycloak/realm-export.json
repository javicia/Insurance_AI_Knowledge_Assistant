{
  "realm": "insurance-ai",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "AI_USER", "description": "Employee asking questions of the assistant and uploading documents." },
      { "name": "AI_GOVERNANCE_ADMIN", "description": "Manages the AI System/Model/Prompt Registry and Risk Assessments." },
      { "name": "AI_AUDITOR", "description": "Read-only access to the AI Audit trail." },
      { "name": "AI_EVALUATION_ADMIN", "description": "Runs and inspects the AI Evaluation dataset." }
    ]
  },
  "clients": [
    {
      "clientId": "insurance-ai-frontend",
      "name": "Insurance AI Assistant (Angular SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:8083/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://localhost:8083",
        "http://localhost:4200"
      ]
    },
    {
      "clientId": "insurance-ai-gateway",
      "name": "Insurance AI Gateway (resource server introspection/testing client)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "gateway-dev-secret-never-used-in-production"
    },
    {
      "clientId": "insurance-ai-e2e-test",
      "name": "E2E/CLI test client - password grant deliberately scoped to this client only",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "secret": "e2e-test-dev-secret-never-used-in-production",
      "attributes": {
        "insurance-ai.purpose": "Password grant is used here, and only here, for scripted/curl-based end-to-end verification against real seeded users (alice/bob/carol/dave) - the real browser SPA client (insurance-ai-frontend) never has direct access grants enabled and only ever uses Authorization Code Flow with PKCE, matching brief FASE 18's explicit requirement."
      }
    }
  ],
  "users": [
    {
      "username": "marina.user",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "Marina",
      "lastName": "User",
      "email": "marina.user@example-insurer.test",
      "credentials": [ { "type": "password", "value": "marina-password", "temporary": false } ],
      "realmRoles": [ "AI_USER" ]
    },
    {
      "username": "marcos.governance",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "Marcos",
      "lastName": "Governance",
      "email": "marcos.governance@example-insurer.test",
      "credentials": [ { "type": "password", "value": "marcos-password", "temporary": false } ],
      "realmRoles": [ "AI_GOVERNANCE_ADMIN" ]
    },
    {
      "username": "carol.auditor",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "Carol",
      "lastName": "Auditor",
      "email": "carol.auditor@example-insurer.test",
      "credentials": [ { "type": "password", "value": "carol-password", "temporary": false } ],
      "realmRoles": [ "AI_AUDITOR" ]
    },
    {
      "username": "david.evaluator",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "David",
      "lastName": "Evaluator",
      "email": "david.evaluator@example-insurer.test",
      "credentials": [ { "type": "password", "value": "david-password", "temporary": false } ],
      "realmRoles": [ "AI_EVALUATION_ADMIN" ]
    }
  ]
}

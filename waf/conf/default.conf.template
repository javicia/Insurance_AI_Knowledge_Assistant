# FASE 20/21: single browser-facing edge (see waf/Dockerfile and docs/adr/ADR-016-WAF-EDGE.md) -
# ModSecurity + OWASP CRS applied to every request, then routed by path: /api/** to the gateway,
# everything else to the frontend's static Angular bundle. Plain HTTP only (matches the rest of
# this PoC stack, e.g. Keycloak's own sslRequired: none) - no TLS termination configured here.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# A real bug, found and fixed via a live 502: nginx's `proxy_pass` with a *literal* hostname
# (as this directive originally used directly) resolves DNS exactly once, at worker startup, and
# caches the resulting IP for the worker's lifetime. When `gateway` or `frontend` are recreated
# independently of the WAF (a routine `docker compose up -d gateway` after a rebuild, not a rare
# event in this project's own development history), the container gets a new Docker-network IP,
# and every WAF worker keeps proxying to the old, now-dead IP - `connect() failed (111: Connection
# refused)` - until the WAF container itself is restarted. Fixed the standard way: a *variable* in
# `proxy_pass`, which forces nginx to re-resolve the hostname on every request instead of caching
# it once. No explicit `resolver` directive added here - the base image's own
# `docker-entrypoint.d/91-update-resolver.sh` already injects one (pointed at Docker's embedded
# DNS) automatically; adding a second one fails nginx startup outright ("resolver" directive is
# duplicate) - found and fixed empirically against the real image, not assumed, matching this
# same file's already-documented ModSecurity duplicate-rule lesson above.

server {
    listen 8080 default_server;
    server_name _;

    # ModSecurity itself is enabled globally by the base image's own untouched
    # conf.d/modsecurity.conf.template (included automatically alongside this file via nginx's
    # `include conf.d/*.conf` directive) - repeating "modsecurity on"/"modsecurity_rules_file"
    # here would load the same 1858-rule CRS rule set a second time and fail to start with a
    # "duplicated rule id" error (found and fixed empirically against the real image, not assumed).

    client_max_body_size 20m;

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_header Authorization;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        set $upstream_api ${API_BACKEND};
        proxy_pass $upstream_api;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        set $upstream_frontend ${FRONTEND_BACKEND};
        proxy_pass $upstream_frontend;
    }

    location = /healthz {
        access_log off;
        modsecurity off;
        add_header Content-Type text/plain;
        return 200 "OK";
    }
}
